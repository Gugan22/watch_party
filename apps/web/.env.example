# =======================================================
# WatchParty — Environment Configuration (Vercel & Local)
# =======================================================

# NextAuth URL and Secret
NEXTAUTH_URL=https://your-watchparty.vercel.app
NEXTAUTH_SECRET=generate_a_random_32_char_secret_here

# Optional: Google OAuth (if omitted, direct email login is used in dev/staging)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Owner configuration (only this email can create rooms)
OWNER_EMAIL=owner@example.com

# Cryptographic secret for signing stateless Room Invite JWTs (4-12 hour expiry)
ROOM_INVITE_SECRET=super_secret_jwt_key_min_32_characters_long

# Base URL for generated invite links
NEXT_PUBLIC_BASE_URL=https://your-watchparty.vercel.app

# LiveKit WebRTC Signaling & Media Credentials
# Get free cloud credentials at https://cloud.livekit.io or enter your remote server credentials
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://your-project.livekit.cloud

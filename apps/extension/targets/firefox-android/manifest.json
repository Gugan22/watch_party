{
  "manifest_version": 2,
  "name": "WatchParty Sync Extension (Firefox Android)",
  "version": "0.1.0",
  "description": "Synchronized video playback and popup shield on Firefox for Android.",
  "permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sync@watchparty.app",
      "strict_min_version": "68.0"
    }
  }
}

{
  "manifest_version": 3,
  "name": "WatchParty — Synchronized Cinema & Video Calls",
  "version": "1.1.0",
  "description": "Watch Netflix, Prime Video, Disney+ Hotstar & Crunchyroll in sync directly inside the WatchParty room stage.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.in/*",
    "*://*.hotstar.com/*",
    "*://*.disneyplus.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.youtube.com/*",
    "*://localhost/*",
    "*://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_headers_rules",
        "enabled": true,
        "path": "rules/strip-headers-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.in/*",
        "*://*.hotstar.com/*",
        "*://*.disneyplus.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content/player-hook.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.in/*",
        "*://*.hotstar.com/*",
        "*://*.disneyplus.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/sidebar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.in/*",
        "*://*.hotstar.com/*",
        "*://*.disneyplus.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content/frame-cleaner.js"],
      "css": ["content/frame-cleaner.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WatchParty Cinema & Video Calls",
    "default_icon": "icons/icon.svg"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/player-hook.js",
        "content/frame-cleaner.js",
        "content/frame-cleaner.css",
        "content/sidebar.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
